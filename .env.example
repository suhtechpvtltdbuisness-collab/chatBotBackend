# MongoDB Configuration
MONGO_URI=mongodb+srv://Ankit:Ankit@cluster0.m609d.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# LLM Provider Configuration
SAMBANOVA_API_KEY=your-sambanova-api-key
# Optional generic alias used by the backend if SAMBANOVA_API_KEY is not set
# LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.sambanova.ai/v1
LLM_MODEL=Meta-Llama-3.1-8B-Instruct
# Keep false in production to avoid silent fake replies
ALLOW_LLM_STUB_FALLBACK=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=https://www.suhtech.shop/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
